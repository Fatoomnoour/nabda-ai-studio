# Starter uses a local, explicitly labeled development adapter; no credentials required.
NEXT_PUBLIC_NABDA_ADAPTER=development
# Planned server-only variables (not needed until backend phase):
# --- Live studio (/studio) server routes — set these in Vercel → Settings → Environment Variables ---
# GEMINI_API_KEY=            # Google AI Studio key (Gemini text + TTS). Preferred.
# ANTHROPIC_API_KEY=         # Optional fallback if no Gemini key.
# GEMINI_MODEL=              # optional pin; default tries gemini-3.1-flash-lite → 3.5-flash-lite → 2.5-flash-lite → 3.8-flash
# GEMINI_THINKING_LEVEL=low
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Kore
# NABDA_TTS=on               # set to "off" to disable server voice
# DAILY_LIMIT_PER_IP=80
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
